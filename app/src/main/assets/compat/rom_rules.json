{
  "_comment": "逐 ROM 后台/权限策略矩阵（PRD v2.2 §6.1 / §6.2，落地路线 10.1 第 7 条）。改这个文件不需要改代码：匹配、深链、文案全部由 CompatRules 解析。component 只做「候选入口」，运行时一律 resolveActivity() 校验，拿不到就退回纯文案，所以写错或系统 OTA 后失效都不会崩。lastVerified=null 表示尚未真机验证。",
  "version": 1,
  "updatedAt": "2026-09-20",
  "sources": {
    "killRating": "https://dontkillmyapp.com/api/v1/output.json（2026-09-20 快照；0=原生行为，5=查杀最重）",
    "components": "PRD v2.2 §6.2.3 与业界公开的同名入口，均未经本机逐一验证"
  },
  "rules": [
    {
      "id": "xiaomi-hyperos",
      "family": "XIAOMI",
      "killRating": 5,
      "impact": "后台查杀 + OTG 独立开关 + WLAN+ 默认开启：息屏后连接被打断、USB 总线突然清空、无网络的相机热点被系统踢掉，三类现象都出在这台机器上",
      "match": {
        "manufacturer": ["xiaomi"],
        "brand": ["xiaomi", "redmi", "poco"],
        "props": ["ro.miui.ui.version.name", "ro.mi.os.version.name"],
        "apiMin": 29
      },
      "tricks": [
        {
          "id": "autostart",
          "text": "小米/红米：设置 → 应用设置 → 自启动管理，允许 N-Link 自启动",
          "component": "com.miui.securitycenter/com.miui.permcenter.autostart.AutoStartManagementActivity",
          "lastVerified": null
        },
        {
          "id": "battery",
          "text": "小米/红米：设置 → 应用设置 → 应用管理 → N-Link → 省电策略 → 选「无限制」",
          "component": "com.miui.powerkeeper/com.miui.powerkeeper.ui.HiddenAppsConfigActivity",
          "lastVerified": null
        },
        {
          "id": "otg",
          "text": "小米/红米：设置 → 更多连接 → OTG 连接（约 10 分钟无操作会自动关闭，重连前请确认它是开的）",
          "lastVerified": "2026-09-19"
        },
        {
          "id": "wlan_plus",
          "text": "小米/红米：设置 → WLAN → 高级设置 → 关闭「WLAN+」与「首次连接提醒需开放网络」，否则没有网络的相机热点会被自动断开",
          "lastVerified": "2026-09-19"
        }
      ]
    },
