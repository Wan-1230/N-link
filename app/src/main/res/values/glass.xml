<?xml version="1.0" encoding="utf-8"?>
<!--
  液态玻璃材质 token（PRD v2.3 §3、附录 A）
  规范：每个颜色都必须有 values-night 对应值；染色一律中性（白/黑 + alpha），
  彩色只允许从被透射的内容里来（colors.xml:39「状态色仅灰度」不受影响）。
-->
<resources>
    <!-- ===== 半径 ===== -->
    <dimen name="glass_radius_xxs">8dp</dimen>
    <dimen name="glass_radius_s">12dp</dimen>
    <dimen name="glass_radius_m">16dp</dimen>
    <dimen name="glass_radius_l">20dp</dimen>
    <dimen name="glass_radius_xl">28dp</dimen>

    <!-- ===== 模糊半径（dp；实现层在 1/8 降采样的纹理上施算，故开销与密度无关） ===== -->
    <item name="glass_blur_s" format="float" type="dimen">12</item>
    <item name="glass_blur_m" format="float" type="dimen">24</item>
    <item name="glass_blur_l" format="float" type="dimen">40</item>
    <item name="glass_blur_xl" format="float" type="dimen">60</item>

    <!-- ===== 染色 tint ===== -->
    <color name="glass_tint_flat">#F2FFFFFF</color>
    <color name="glass_tint_content">#D9FFFFFF</color>
    <!-- 悬浮控件专用：真正半透明，滑动时看得见底下的模糊内容在动。
         85%（tint_content）贴在白页上等于不透明，玻璃就白做了。 -->
    <color name="glass_tint_floating">#8FFFFFFF</color>
    <color name="glass_tint_moving">#EAFFFFFF</color>
    <color name="glass_tint_dark">#BF000000</color>
    <color name="glass_tint_scrim">#99000000</color>
    <!-- 按压时叠加的中性提浓量（alpha 加数） -->
    <color name="glass_tint_press">#14000000</color>

    <!-- ===== 四条边信息：外描边 / 内顶高光 / 内底反光 / 四角透镜亮线 ===== -->
    <color name="glass_stroke_outer">#2B000000</color>
    <color name="glass_rim_top">#66FFFFFF</color>
    <!-- 26% → 8%：整圈 20% 黑的描边 + 1px 10% 黑底线，在通栏顶栏上就是两条黑线 -->
    <color name="glass_rim_bottom">#14000000</color>
    <color name="glass_edge_lens">#4DFFFFFF</color>

    <!-- ===== v2.6.2 新增：镜面亮线 + 内阴影 =====
         苹果玻璃的"像玻璃"靠的是**上沿那条极亮的细线**（镜面反射的主峰）与
         **底边内侧那道短暗渐变**（内阴影 → 厚度）。原来的四条边信息里这两条都没有：
         顶部只有一条铺满半张面的白色渐变（读作磨砂塑料），底部只有 1px 8% 黑。
         补上之后层级才从"半透明面片"变成"有厚度的实体"。 -->
    <!-- 上沿镜面亮线：比 rim_top 更亮、更窄 -->
    <color name="glass_specular_line">#B3FFFFFF</color>
    <!-- 底边内侧内阴影（向上衰减），给玻璃厚度 -->
    <color name="glass_inner_shadow">#1F000000</color>
    <!-- 顶部高光带的高度上限（dp）：原来恒取面高的一半，62dp 的 dock 会白掉 31dp -->
    <item name="glass_rim_band_max_dp" format="float" type="dimen">16</item>
    <!-- 上沿亮线的厚度（dp） -->
    <item name="glass_specular_h_dp" format="float" type="dimen">1.2</item>
    <!-- 内阴影带的高度上限（dp） -->
    <item name="glass_inner_band_max_dp" format="float" type="dimen">8</item>
    <!-- 通栏（radius=0）贴屏幕边时唯一保留的那条发丝线，比 rim_bottom 更轻 -->
    <color name="glass_hairline_fitted">#0F000000</color>

    <!-- ===== 阴影（L3 用 elevation 走 GPU 路径，L1/L2 用描边近似） =====
         这两个值不是"最终阴影浓度"，而是**喂给 Android 投影管线的着色**：
         系统还会按高度再乘一层衰减，所以默认那套（纯黑 × 系统 alpha）在浅底上发硬。
         压低 alpha + 拉开 key/ambient 比例，才得到柔和的双层阴影。 -->
    <color name="glass_shadow_key">#33000000</color>
    <color name="glass_shadow_ambient">#1A000000</color>
    <color name="glass_shadow_floating">#1F000000</color>
    <dimen name="glass_elevation_l3">8dp</dimen>
    <dimen name="glass_elevation_l1">1.5dp</dimen>
    <dimen name="glass_stroke_w">1dp</dimen>
    <dimen name="glass_stroke_w_thin">0.5dp</dimen>

    <!-- ===== dock 几何（悬浮：四周内缩，分割线职责交给 rim） ===== -->
    <dimen name="glass_dock_height">62dp</dimen>
    <dimen name="glass_dock_inset_h">12dp</dimen>
    <dimen name="glass_dock_inset_bottom">10dp</dimen>
    <!-- PRD §7.1：≥600dp（medium/expanded）时 dock 收到此宽度并居中。
         大屏最常见的玻璃失败模式就是把手机那条横栏拉成 12 英寸。 -->
    <dimen name="glass_dock_max_width">480dp</dimen>

    <!-- ===== 弹窗面板底（配合窗口级 blur-behind 使用） ===== -->
    <color name="glass_dialog_surface">#F0FFFFFF</color>

    <!-- ===== 运行时预算与配额（PRD §3.1、§8.2） ===== -->
    <item name="glass_backdrop_downscale" format="float" type="dimen">0.125</item>
    <!-- 苹果式 vibrancy：模糊后在线性空间把饱和度抬一档（>1 生效）。
         灰阶 UI 上不可见，压在照片 / 彩色内容上才显出来。参考两边项目的实现。 -->
    <item name="glass_saturation" format="float" type="dimen">1.15</item>
    <integer name="glass_backdrop_max_long_edge">320</integer>
    <integer name="glass_backdrop_debounce_ms">120</integer>
    <integer name="glass_backdrop_scroll_idle_ms">90</integer>
    <!-- 同屏真模糊面上限（AC-4 运行时检查）。v2.3 初稿写的 3 是" dock + 一块顶栏 + 一个
         操作坞"的算式；v2.3.1 把相册页的分段胶囊也提成悬浮玻璃，主界面稳定态就是
         dock + 顶栏底片 + 胶囊 = 3，多选态再多一面操作坞 → 放到 4。
         再往上加要先想清楚 §8.2 的帧预算，别拿这个数当免费额度。 -->
    <integer name="glass_max_blur_surfaces">4</integer>
    <integer name="glass_max_coverage_pct">45</integer>
</resources>
