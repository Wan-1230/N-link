<?xml version="1.0" encoding="utf-8"?>
<!-- 全局边距规范：页面左右 24dp，模块间距 16-24dp，组内间距 8-12dp -->
<resources>
    <dimen name="page_margin">24dp</dimen>
    <dimen name="module_gap_large">24dp</dimen>
    <dimen name="module_gap">16dp</dimen>
    <dimen name="group_gap">12dp</dimen>
    <dimen name="group_gap_small">8dp</dimen>
    <dimen name="divider_height">1dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════
         圆角阶梯 · **全工程唯一真相源**

         改这里之前有三套重叠体系：glass_radius_xxs/s/m/l/xl（8/12/16/20/28）、
         card_radius（12）、lv_radius_sm/md/lg（8/12/16），共 9 个 token 约 35 处引用。
         同一个 12dp 有三个名字，等于没有阶梯——anti-cheap.md:53 把「混用圆角体系」
         （方布局里配圆按钮）列为廉价 tell，design-model.yaml 也要求 radius_scale 锁死一档。

         收敛方式：只在这里定义 6 个语义档，原有 9 个 token 全部改成**引用别名**
         （见本文件下方与 values/glass.xml）。35 处调用点一行未动，
         但从此改一个数字全工程生效，也不会再冒出第四个名字。

         档位按「越靠近用户越圆」排：控件最方（8）、卡片次之（12）、
         浮层更圆（16）、抽屉最圆（20）、对话框（28）、胶囊（999）。
         h5-mobile.md:443 的依据：小圆角读作网页，大圆角读作 app——
         但那是给 390px 固定框的建议值（卡片 16–22px），原生 App 的 dp 与 CSS px
         在 ~2.75x 密度下不是 1:1，照搬会过圆。此处沿用项目既有的 8/12 档，
         只在浮层与抽屉上放大，保持工具类 App 的克制。
         ══════════════════════════════════════════════════════════════════ -->
    <dimen name="radius_control">8dp</dimen>
    <dimen name="radius_card">12dp</dimen>
    <dimen name="radius_overlay">16dp</dimen>
    <dimen name="radius_sheet">20dp</dimen>
    <dimen name="radius_dialog">28dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- 历史 token → 唯一阶梯的别名。保留名字是为了 35 处调用点零改动，
         新增代码请直接引用上面的 radius_*。 -->
    <dimen name="card_radius">@dimen/radius_card</dimen>

    <!-- 视S2/T9 间距标尺（中性名）：4/8/12/16/20/24 六档，只做**精确值归位**——
         原布局裸 dp 与档位值相同的引用本处，零视觉位移；10dp 等非栅格值维持原值
         不动（改档会移像素，需逐页视觉 QA，留待真机轮）。语义名 token
         （page_margin/module_gap/group_gap）继续用于有意图的场景。 -->
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_20">20dp</dimen>
    <dimen name="space_24">24dp</dimen>

    <!-- 视S1 字号阶梯：全 App 只允许这 6 档（对齐 NlText.* 与视觉规范 v2.6.5 的 24/16/14/13）。
         布局里 textSize 一律引用 @dimen/font_*，不再允许裸 sp（2026-10-04 起 221 处已全量替换）。
         映射口径：24→display；22/20/18/17/16→title；15/14→body；13→caption；12→nav；11/10/9→foot -->
    <dimen name="font_display">24sp</dimen>
    <dimen name="font_title">16sp</dimen>
    <dimen name="font_body">14sp</dimen>
    <dimen name="font_caption">13sp</dimen>
    <dimen name="font_nav">12sp</dimen>
    <dimen name="font_foot">11sp</dimen>

    <!-- 全屏监看 HUD 圆角：改为引用唯一阶梯（原 8/12/16 三档与阶梯同值，视觉零变化）。
         保留 lv_ 前缀是因为监看页尺寸族自成一组（lv_bar_h_padding / lv_tool_h …），
         按前缀检索时不该断链。 -->
    <dimen name="lv_radius_sm">@dimen/radius_control</dimen>
    <dimen name="lv_radius_md">@dimen/radius_card</dimen>
    <dimen name="lv_radius_lg">@dimen/radius_overlay</dimen>

    <dimen name="lv_bar_h_padding">12dp</dimen>
    <dimen name="lv_bar_v_padding">8dp</dimen>
    <dimen name="lv_cell_gap">4dp</dimen>
    <dimen name="lv_tool_h">58dp</dimen>
    <dimen name="lv_tool_h_land">50dp</dimen>
    <dimen name="lv_shutter">72dp</dimen>
    <dimen name="lv_shutter_inner">54dp</dimen>
    <dimen name="lv_icon_btn">36dp</dimen>
    <dimen name="lv_icon_btn_land">32dp</dimen>
    <dimen name="lv_graph_w">128dp</dimen>
    <dimen name="lv_graph_h">56dp</dimen>
    <dimen name="lv_card_pad">10dp</dimen>
    <dimen name="lv_sheet_pad_h">18dp</dimen>
    <dimen name="lv_sheet_pad_top">14dp</dimen>
    <dimen name="lv_sheet_pad_bottom">18dp</dimen>

    <!-- 底簇三行的紧凑度。竖屏就是下面这些值（与改造前的硬编码逐位相同，视觉零变化）；
         横屏由 values-land/dimens.xml 收紧 —— 横屏可用高只有 ~360dp，
         底簇按竖屏尺寸会吃掉半幅画面。 -->
    <dimen name="lv_param_pad_v">6dp</dimen>
    <dimen name="lv_param_cell_pad_v">6dp</dimen>
    <dimen name="lv_param_cell_margin">3dp</dimen>
    <dimen name="lv_shutter_row_pad_top">6dp</dimen>
    <dimen name="lv_shutter_row_pad_bottom">12dp</dimen>
    <!-- ToolItemView 自绘内部尺寸（图标框 + 标签竖排），改这几项即改工具行整体高度 -->
    <dimen name="lv_tool_pad_top">6dp</dimen>
    <dimen name="lv_tool_pad_bottom">4dp</dimen>
    <dimen name="lv_tool_icon_box_h">28dp</dimen>
    <dimen name="lv_tool_icon_h">25dp</dimen>

    <!-- 拍摄页取景区：画面按自身比例定高，这两项是上下两道闸。
         下限保证"还没帧"时那块面板不塌（开始监看按钮要有地方站），
         上限保证机身给出非常规比例（1:1、竖幅）时不吃掉整个屏幕。

         272/380dp 是 2026-10-18 调出来的中间值：改版前这里是 `weight=2` 撑出的 2/3 屏高
         （模拟器 1080×2400 实测 ~404dp），横向画面在里面上下各留一条黑；改版后压到 168dp，
         面板是贴住了画面，但整块取景窗小了一圈。272dp ≈ 取景区满宽（411dp 屏上为 363dp）
         的 3:4，面板本身呈 4:3 形状 —— 3:2 与 16:9 的画面放进去都只剩很窄的一道边。 -->
    <dimen name="remote_lv_min_h">272dp</dimen>
    <dimen name="remote_lv_max_h">380dp</dimen>
</resources>
