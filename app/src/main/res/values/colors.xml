<?xml version="1.0" encoding="utf-8"?>
<!-- 黑白双色设计系统 · 日间模式 -->
<resources>
    <!-- 背景层：纯白主背景，浅灰次级背景 -->
    <color name="page">#FFFFFF</color>
    <color name="background">#FFFFFF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F5F5F5</color>
    <color name="panel_2">#F5F5F5</color>
    <color name="outline">#E4E4E4</color>
    <color name="divider">#EBEBEB</color>

    <!-- 对比卡片（日间=纯黑底白字；夜间=纯白底黑字） -->
    <color name="dark_card">#000000</color>
    <color name="dark_card_inner">#1A1A1A</color>
    <color name="dark_card_surface">#262626</color>
    <color name="on_dark_card">#FFFFFF</color>
    <color name="on_dark_card_variant">#A3A3A3</color>

    <!-- 文字层：一级纯黑 / 二级深灰 / 辅助中灰 -->
    <color name="text_primary">#000000</color>
    <color name="text_secondary">#525252</color>
    <color name="text_tertiary">#8C8C8C</color>
    <color name="on_background">#000000</color>
    <color name="on_surface">#000000</color>
    <color name="on_surface_variant">#737373</color>

    <!-- 组件层：主按钮/选中态纯黑填充 -->
    <color name="primary">#000000</color>
    <color name="primary_variant">#1A1A1A</color>
    <color name="accent">#000000</color>
    <color name="accent_soft">#F5F5F5</color>
    <color name="on_primary">#FFFFFF</color>

    <color name="secondary">#262626</color>
    <color name="secondary_variant">#404040</color>
    <color name="on_secondary">#FFFFFF</color>

    <!-- 状态色：仅灰度表达（规范：除下方品牌强调色外不引入彩色） -->
    <color name="status_disconnected">#BFBFBF</color>
    <color name="ble_indicator">#525252</color>
    <color name="wifi_indicator">#000000</color>

    <!-- ══════════════════════════════════════════════════════════════════
         v2.6.5 品牌强调色（尼康黄）—— **唯一** 的彩色，且**只允许**用在两处：
           ① 连接状态指示灯（status_connected）
           ② 主功能按钮（NlButton.Primary 的填充）
         其它任何控件、图标、文字、选中态一律继续走黑白灰。
         这条约束是刻意收紧的：强调色一旦铺开就不再是强调，界面会重新变得嘈杂。
         回退方式：把下面两个 token 改回 #000000/#FFFFFF 即可整体还原为纯黑白。
         ══════════════════════════════════════════════════════════════════ -->
    <color name="nikon_yellow">#FFE100</color>
    <!-- 黄底上的文字/图标：必须用黑，白字在黄底上对比度不足（≈1.5:1） -->
    <color name="on_nikon_yellow">#000000</color>
    <!-- 连接状态指示灯·已连接 -->
    <color name="status_connected">#FFE100</color>

    <!-- 点击反馈 / 遮罩 -->
    <color name="chip_unselected">#F0F0F0</color>

    <!-- Switch 开关：OFF 轨道中性灰（深浅色主题均可见），滑块白色内嵌 -->
    <color name="switch_track_off">#8F8F8F</color>
    <color name="switch_thumb_off">#FFFFFF</color>

    <!-- Live View 专用 -->
    <color name="liveview_scrim">#99000000</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="liveview_text">#E6FFFFFF</color>

    <!-- 全屏监看（飓风相机 / Blackmagic Cam 参考）：纯黑底 + 灰阶层级 + 单一琥珀强调色。
         强调色只承担「当前值 / 激活态」语义，全屏可见处不超过 4 个：
         刻度尺游标、分段选中段、跟焦轮驱动位、监看中状态点。
         其余层级一律用灰度，避免多色堆叠。 -->
    <!-- 全屏监看（飓风相机 / Blackmagic Cam 参考）：纯黑底 + 灰阶层级 + 单一强调色。
         强调色只承担「当前值 / 激活态」语义，全屏可见处不超过 4 个：
         刻度尺游标、分段选中段、跟焦轮驱动位、监看中状态点。
         其余层级一律用灰度，避免多色堆叠。

         色值直接引用品牌色 nikon_yellow（v2.6.5 规范）：监看页的取景画面亮度不可控，
         选中态只用灰度会读不出来，因此这里是有意为之的例外（小万 2026-10-03 拍板）。
         想让它彻底回归 §1.1 的「只两处」，把本行改成 @color/white 即可，无需动布局。 -->
    <color name="lv_accent">@color/nikon_yellow</color>
    <color name="lv_accent_soft">#26FFE100</color>
    <!-- v2.7.2 玻璃下线：全部实体化。层次靠色阶（面板最暗 → 卡片居中 → 芯片最亮）
         与 1dp 描边区分，不再靠透出画面 -->
    <color name="lv_panel">#F5141416</color>
    <color name="lv_card">#F21B1B1D</color>
    <color name="lv_card_solid">#F21B1B1D</color>
    <color name="lv_chip">#F2252527</color>
    <color name="lv_chip_active">#33FFFFFF</color>
    <color name="lv_text">#FFFFFFFF</color>
    <color name="lv_text_dim">#8CFFFFFF</color>
    <color name="lv_outline">#26FFFFFF</color>
    <color name="lv_badge_red">#8A2B26</color>
    <color name="lv_seg_track">#1FFFFFFF</color>
    <color name="lv_seg_sel">#33FFFFFF</color>

    <!-- 底部导航：背景与页面底色一致 -->
    <color name="nav_background">#FFFFFF</color>
    <!-- 选中项背后的胶囊：玻璃 dock 上用轻微下沉的暗色，实体 dock 上同样成立 -->
    <color name="nav_selected_bg">#14000000</color>
    <color name="nav_active_icon">#000000</color>
    <color name="nav_inactive_icon">#9E9E9E</color>
</resources>
