<?xml version="1.0" encoding="utf-8"?>
<!--
  横竖屏切换图标：竖屏「屏幕」轮廓 + 右侧环绕旋转箭头。

  旧图标是单纯的旋转圆环，没有屏幕主体，用户无法判断它作用于画面还是别的对象。
  新图标把「被旋转的东西」明确画成一个竖屏矩形，语义一眼可读：点它 = 把画面转 90°。

  坐标（24×24 视口）：
  - 屏幕：圆角矩形 x∈[4,13] y∈[4.5,19.5]，圆角 1.5（竖屏比例，直观表达「当前方向」）
  - 箭头：外凸弧线 x=16.5 起止 y∈[5.5,18]，半径 8（右侧绕行，表达「旋转」）
  - 箭头尖：底朝下的三角，与弧线末端在 y=18 处相接
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 屏幕：竖屏圆角矩形 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5.5,4.5 h6 a1.5,1.5 0 0,1 1.5,1.5 v12 a1.5,1.5 0 0,1 -1.5,1.5 h-6 a1.5,1.5 0 0,1 -1.5,-1.5 v-12 a1.5,1.5 0 0,1 1.5,-1.5 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.7" />

    <!-- 旋转箭头：屏幕右侧外凸弧线 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M16.5,5.5 a8,8 0 0,1 0,12.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.7" />

    <!-- 箭头尖：朝下，与弧线末端相接 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16.5,21.8 l-2.6,-3.8 h5.2 z" />
</vector>
