<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏参数面板：底部渐变变体。从近实色（下）到 85% 黑（上），
     视觉上「沉」进画面而不是一块浮着的实心板；圆角与描边保持与竖屏面板同档 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F5141416"
        android:endColor="#D9141416" />
    <stroke
        android:width="1dp"
        android:color="@color/lv_outline" />
    <corners android:radius="@dimen/lv_radius_lg" />
</shape>
