<?xml version="1.0" encoding="utf-8"?>
<!-- 取景器快门：外圈黄色圆环 + 黑色内圈 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFC400" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>
</layer-list>
