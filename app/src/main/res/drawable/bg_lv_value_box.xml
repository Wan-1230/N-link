<?xml version="1.0" encoding="utf-8"?>
<!-- 跟焦轮读数框：中性描边暗底。读数本身是「当前值」才上强调色，框体保持中性 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lv_chip" />
    <stroke
        android:width="1dp"
        android:color="@color/lv_outline" />
    <corners android:radius="@dimen/lv_radius_md" />
</shape>
