<?xml version="1.0" encoding="utf-8"?>
<!-- Tab3 遥控拍摄：实时监看(2/3) + 参数控制区(1/3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- 顶部：照片/视频模式切换 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_margin">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnModePhoto"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="照片"
                android:textColor="@color/on_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnModeVideo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="视频"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRemoteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未连接"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 实时取景区域（占 2/3） -->
    <FrameLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/page_margin"
        android:layout_weight="2"
        android:background="@drawable/bg_liveview">

        <ImageView
            android:id="@+id/ivLiveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="实时取景画面"
            android:scaleType="fitCenter" />

        <!-- 三分构图网格线 -->
        <ImageView
            android:id="@+id/viewGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="网格线"
            android:scaleType="fitXY"
            android:src="@drawable/bg_grid_thirds"
            android:visibility="gone" />

        <!-- 顶部悬浮信息：半透黑底白字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/liveview_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/ivLvBattery"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="电量"
                android:src="@drawable/ic_battery"
                app:tint="@color/liveview_text" />

            <TextView
                android:id="@+id/tvLvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="@color/liveview_text"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ivLvShots"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:contentDescription="剩余"
                android:src="@drawable/ic_sd_card"
                app:tint="@color/liveview_text" />

            <TextView
                android:id="@+id/tvLvShots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=""
                android:textColor="@color/liveview_text"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLvConn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textColor="@color/liveview_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 录制状态标识：实心圆点 + 时长（灰度，不引入彩色） -->
        <LinearLayout
            android:id="@+id/layoutRecordBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@color/liveview_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="录制中"
                android:src="@drawable/ic_record_dot"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvRecordTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 触摸对焦点指示器（淡入淡出） -->
        <ImageView
            android:id="@+id/viewFocusIndicator"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="对焦点"
            android:src="@drawable/ic_focus"
            android:visibility="gone"
            app:tint="@color/white" />

        <!-- 开始监看按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartLv"
            style="@style/NlButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:paddingHorizontal="28dp"
            android:text="开始监看" />

        <!-- 横屏全屏监看入口 -->
        <ImageView
            android:id="@+id/btnFullscreenLv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_fullscreen_button"
            android:contentDescription="全屏监看"
            android:padding="9dp"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/white" />

        <!-- 快门闪白反馈 -->
        <View
            android:id="@+id/viewFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 参数控制区（占 1/3） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <!-- 基础参数行：模式/光圈/快门/ISO/白平衡（点击弹出滚轮选择器） -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/page_margin"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/paramRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 快门区：定时 | 快门 | 间隔/场景 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_margin">

            <FrameLayout
                android:id="@+id/btnTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="定时拍摄"
                    android:src="@drawable/ic_timer"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="36dp"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:id="@+id/ivShutterIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="快门"
                    android:src="@drawable/ic_shutter_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnModeAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="间隔拍摄"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 底部信息行：拍摄计数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingHorizontal="@dimen/page_margin"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvShotCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已拍 0 张"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
