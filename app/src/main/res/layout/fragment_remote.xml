<?xml version="1.0" encoding="utf-8"?>
<!-- Tab3 遥控拍摄：实时监看(2/3) + 参数控制区(1/3) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- 顶部：照片/视频模式切换 + 状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_margin">

        <!--
          照片/视频切换：FrameLayout 槽 + 背后的**滑动指示块**。
          以前是"选中的那个 TextView 换实心底"，所以切换是硬切；
          现在指示块是一枚真滑块，位移与宽度跟着目标标签走（GlassMotion.slidePill）。
          经典外观下把它瞬间归位（不带动画），观感与 v2.2 一致。
        -->
        <FrameLayout
            android:id="@+id/modeToggleSlot"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip"
            android:padding="3dp">

            <View
                android:id="@+id/modeIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_selected" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- 默认写未选中的字色：选中态的黑底胶囊要等运行时量到标签宽度才能落位
                     （见 RemoteFragment.layoutModeIndicator），首帧底还不在，
                     这里若写 on_primary 就是白字白底。真实状态由 renderModeToggle 立刻覆盖。 -->
                <TextView
                    android:id="@+id/btnModePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/btn_mode_photo_text"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/btnModeVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/btn_mode_video_text"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 画面模式下拉（v1.0.2 从长按菜单迁入）：收起显示当前模式，
             展开显示带说明的选项（联动=相机屏同显 / 遥控=相机屏熄） -->
        <TextView
            android:id="@+id/chipDisplayMode"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/chip_display_mode_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />

        <TextView
            android:id="@+id/tvRemoteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tv_remote_status_text"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_nav" />
    </LinearLayout>

    <!-- 视T5：拍摄失败内联状态条——失败原因留在页面上（点一下收起），不再只靠转瞬即逝的 Toast -->
    <com.nikonlink.app.shared.ui.widget.NlStateBar
        android:id="@+id/stateRemote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_margin"
        android:layout_marginEnd="@dimen/page_margin"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- 实时取景（2026-10-18 改版）：容器高度改由画面自身比例决定。
         原来是 `weight=2` 撑走 2/3 屏高，而相机给的帧是横向比例（3:2 / 16:9），
         fitCenter 之后上下各留一大条纯黑 —— 看着像"画面被裁"，其实是框比画面大。
         现在 adjustViewBounds 让 ImageView 跟着帧的宽高比定高，黑边收掉，
         省下来的竖向空间全部给下方的功能区（按钮更大、多两颗常用键）。
         minHeight 兜住"还没有画面"的状态：没帧时这里仍是一块可点的取景面板，
         不会塌成一条线；maxHeight 兜住极端比例（机身若给 1:1 或竖幅）。 -->
    <FrameLayout
        android:id="@+id/liveContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_margin"
        android:layout_marginTop="@dimen/space_8"
        android:minHeight="@dimen/remote_lv_min_h"
        android:background="@drawable/bg_liveview">

        <ImageView
            android:id="@+id/ivLiveView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="实时取景画面"
            android:maxHeight="@dimen/remote_lv_max_h"
            android:minHeight="@dimen/remote_lv_min_h"
            android:scaleType="fitCenter" />

        <!-- 三分构图网格线 -->
        <ImageView
            android:id="@+id/viewGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="网格线"
            android:scaleType="fitXY"
            android:src="@drawable/bg_grid_thirds"
            android:visibility="gone" />

        <!-- 顶部悬浮信息：半透黑底白字 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/liveview_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="@dimen/space_8">

            <ImageView
                android:id="@+id/ivLvBattery"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="电量"
                android:src="@drawable/ic_battery"
                app:tint="@color/liveview_text" />

            <TextView
                android:id="@+id/tvLvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:text=""
                android:textColor="@color/liveview_text"
                android:textSize="@dimen/font_foot" />

            <ImageView
                android:id="@+id/ivLvShots"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:contentDescription="剩余"
                android:src="@drawable/ic_sd_card"
                app:tint="@color/liveview_text" />

            <TextView
                android:id="@+id/tvLvShots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:text=""
                android:textColor="@color/liveview_text"
                android:textSize="@dimen/font_foot" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLvConn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_lv_conn_text"
                android:textColor="@color/liveview_text"
                android:textSize="@dimen/font_foot" />
        </LinearLayout>

        <!-- 录制状态标识：实心圆点 + 时长（灰度，不引入彩色） -->
        <LinearLayout
            android:id="@+id/layoutRecordBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="40dp"
            android:background="@color/liveview_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="录制中"
                android:src="@drawable/ic_record_dot"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvRecordTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00"
                android:textColor="@color/white"
                android:textSize="@dimen/font_nav"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 触摸对焦点指示器（淡入淡出） -->
        <ImageView
            android:id="@+id/viewFocusIndicator"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="对焦点"
            android:src="@drawable/ic_focus"
            android:visibility="gone"
            app:tint="@color/white" />

        <!-- 开始监看按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartLv"
            style="@style/NlButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:paddingHorizontal="28dp"
            android:text="@string/btn_start_lv_text" />

        <!-- 2026-10-18：「全屏监看」「直方图」两颗悬浮按钮从画面右上角挪到画面下方的
             工具行（rowLvTools）—— 悬浮在画面上就是压住取景内容，
             而这两颗是开关类操作，不必贴着自己的效果摆。 -->

        <!-- 实时亮度直方图（优化项 4）：贴取景区底部，随监看帧同步刷新 -->
        <com.nikonlink.app.camera.liveview.HistogramView
            android:id="@+id/viewHistogram"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- 快门闪白反馈 -->
        <View
            android:id="@+id/viewFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 参数控制区：取景区省下来的竖向空间全归这里 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_8">

        <!-- 取景辅助工具行（2026-10-18 新增）：
             前两颗是原先压在画面右上角的「全屏监看」「直方图」，后两颗补的是常用项 ——
             「网格」开关三分构图线（画面里本来就有这层，此前没有任何入口）、
             「刷新参数」重读机身的光圈/快门/ISO/白平衡（参数看着不动时不用退出重进）。
             四格等宽 + 40dp 方形芯片 + 11sp 标签：320dp 屏每格仍有 ~68dp，图标不会挤在一起。
             图标沿用同族线性矢量（ic_fullscreen / ic_histogram / ic_grid_toggle / ic_refresh）。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_margin"
            android:paddingBottom="@dimen/space_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnFullscreenLv"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_fullscreen_button"
                    android:contentDescription="全屏监看"
                    android:padding="9dp"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/txt_全屏"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_foot" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnHistogram"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_fullscreen_button"
                    android:contentDescription="@string/histogram_toggle"
                    android:padding="9dp"
                    android:src="@drawable/ic_histogram"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/txt_直方图"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_foot" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnGrid"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_fullscreen_button"
                    android:contentDescription="@string/txt_网格"
                    android:padding="9dp"
                    android:src="@drawable/ic_grid_toggle"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/txt_网格"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_foot" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnRefreshParams"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_fullscreen_button"
                    android:contentDescription="@string/txt_刷新参数"
                    android:padding="9dp"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="@string/txt_刷新参数"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_foot" />
            </LinearLayout>
        </LinearLayout>

        <!-- 基础参数行：模式/光圈/快门/ISO/白平衡（点击弹出滚轮选择器）。
             与上面的工具行、下面的快门区各占 1/3 权重 —— 取景区按画面比例缩掉之后
             多出来的竖向空间平摊给三段，避免堆成中间一个大空洞。 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/page_margin"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/paramRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 快门区：定时 | 快门 | 间隔/场景 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/page_margin">

            <FrameLayout
                android:id="@+id/btnTimer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="定时拍摄"
                    android:src="@drawable/ic_timer"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnShutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="36dp"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:id="@+id/ivShutterIcon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="快门"
                    android:src="@drawable/ic_shutter_white" />
            </FrameLayout>

            <!-- 分体按钮：左侧主体单击执行当前模式；右侧箭头弹下拉切换模式
                 （间隔拍摄 / B 门长曝光），取代旧「长按弹菜单 + 教程气泡」 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_chip">

                <TextView
                    android:id="@+id/btnModeAction"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_8"
                    android:text="@string/btn_mode_action_text"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_nav"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnModeActionArrow"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="切换拍摄模式"
                    android:padding="6dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部信息行：拍摄计数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingHorizontal="@dimen/page_margin"
            android:paddingBottom="@dimen/space_12">

            <TextView
                android:id="@+id/tvShotCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_shot_count_text"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/font_nav" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
