<?xml version="1.0" encoding="utf-8"?>
<!-- F7 打赏支持页：白底卡片展示微信收款码，深浅色均保证扫码对比度 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_n_link"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/txt_连接传输"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_body" />

        <!-- 二维码卡片：恒为白色圆角底（深色模式下保证扫码对比度） -->
        <androidx.cardview.widget.CardView
            android:id="@+id/qrCard"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_24"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivQr"
                    android:layout_width="232dp"
                    android:layout_height="232dp"
                    android:contentDescription="微信收款二维码"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_donate_wechat_qr" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/txt_微信扫码"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_nav" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 操作行：放大 / 保存 / 分享（均走系统标准能力，便于另一台手机扫码） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnZoomQr"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_zoom_qr_text"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_caption" />

            <TextView
                android:id="@+id/btnSaveQr"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_save_qr_text"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_caption" />

            <TextView
                android:id="@+id/btnShareQr"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/btn_share_qr_text"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_caption" />
        </LinearLayout>

        <!-- 自愿声明（文案红线：不得出现解锁/付费/配额/权益） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/txt_打赏完全自愿"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_nav" />

        <!-- GitHub 入口：点 Star 也是支持 -->
        <TextView
            android:id="@+id/btnGithub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/space_8"
            android:text="@string/btn_github_text"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/font_caption" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
