<?xml version="1.0" encoding="utf-8"?>
<!-- 视T6 自 fragment_dashboard 抽取：原块内容零改动 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/NlCard"
    app:cardBackgroundColor="@color/dark_card"
    app:strokeColor="@color/dark_card_surface">


                    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_20">

                        <!-- 连接状态行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/viewStatusIndicator"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot" />

                            <TextView
                                android:id="@+id/tvConnectionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_8"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/tv_connection_status_text"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_caption" />

                            <ProgressBar
                                android:id="@+id/progressConnecting"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="@dimen/space_8"
                                android:indeterminateTint="@color/on_dark_card_variant"
                                android:visibility="gone" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvStatusMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxWidth="160dp"
                                android:maxLines="1"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_nav" />
                        </LinearLayout>

                        <!-- 相机全称 -->
                        <TextView
                            android:id="@+id/tvCameraName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="1"
                            android:text="Nikon"
                            android:textColor="@color/on_dark_card"
                            android:textSize="@dimen/font_display" />

                        <!-- 2026-10-17：电池 / 存储卡 / 剩余可拍 / 镜头四行整体搬进设备页下方的
                             参数四宫格，本卡不再重复一遍（原来四行 + 相机名占了大半张卡的纵向空间，
                             却和下面的网格说的是同一批数）。卡片只保留状态行与相机全称 + 连接/断开。 -->

                        <!-- 连接 / 断开按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnect"
                            style="@style/NlButton.Contrast"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:maxLines="1"
                            android:text="@string/btn_connect_text"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDisconnect"
                            style="@style/NlButton.ContrastOutline"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:maxLines="1"
                            android:text="@string/btn_disconnect_text"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
