<?xml version="1.0" encoding="utf-8"?>
<!-- 视T6 自 fragment_dashboard 抽取：原块内容零改动 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/NlCard"
    app:cardBackgroundColor="@color/dark_card"
    app:strokeColor="@color/dark_card_surface">


                    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- 连接状态行 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/viewStatusIndicator"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_status_dot" />

                            <TextView
                                android:id="@+id/tvConnectionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="未连接"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_caption" />

                            <ProgressBar
                                android:id="@+id/progressConnecting"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="8dp"
                                android:indeterminateTint="@color/on_dark_card_variant"
                                android:visibility="gone" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvStatusMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxWidth="160dp"
                                android:maxLines="1"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_nav" />
                        </LinearLayout>

                        <!-- 相机全称 -->
                        <TextView
                            android:id="@+id/tvCameraName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="1"
                            android:text="Nikon"
                            android:textColor="@color/on_dark_card"
                            android:textSize="@dimen/font_display" />

                        <!-- 电池 -->
                        <LinearLayout
                            android:id="@+id/rowBattery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="电池"
                                android:src="@drawable/ic_battery"
                                app:tint="@color/on_dark_card_variant" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="电池电量"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvBattery"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/on_dark_card"
                                android:textSize="@dimen/font_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 存储卡 -->
                        <LinearLayout
                            android:id="@+id/rowStorage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="存储"
                                android:src="@drawable/ic_sd_card"
                                app:tint="@color/on_dark_card_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="存储卡"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_caption" />

                            <ProgressBar
                                android:id="@+id/pbStorage"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_marginHorizontal="10dp"
                                android:layout_weight="1"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="@color/on_dark_card"
                                android:progressBackgroundTint="@color/on_dark_card_variant" />

                            <TextView
                                android:id="@+id/tvStorage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:maxWidth="176dp"
                                android:text=""
                                android:textColor="@color/on_dark_card"
                                android:textSize="@dimen/font_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 剩余可拍 -->
                        <LinearLayout
                            android:id="@+id/rowShotsRemaining"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="剩余可拍"
                                android:src="@drawable/ic_nav_camera"
                                app:tint="@color/on_dark_card_variant" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="剩余可拍摄"
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvShotsRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/on_dark_card"
                                android:textSize="@dimen/font_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 镜头信息 -->
                        <LinearLayout
                            android:id="@+id/rowLens"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="镜头"
                                android:src="@drawable/ic_lens"
                                app:tint="@color/on_dark_card_variant" />

                            <TextView
                                android:id="@+id/tvLens"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text=""
                                android:textColor="@color/on_dark_card_variant"
                                android:textSize="@dimen/font_nav" />
                        </LinearLayout>

                        <!-- 连接 / 断开按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnect"
                            style="@style/NlButton.Contrast"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:text="连接相机"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDisconnect"
                            style="@style/NlButton.ContrastOutline"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:text="断开连接"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
