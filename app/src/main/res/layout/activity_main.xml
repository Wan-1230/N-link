<?xml version="1.0" encoding="utf-8"?>
<!--
  主框架：状态栏玻璃条 + 内容区 + 悬浮玻璃 dock。
  不再用 fitsSystemWindows：改由 MainActivity 手动分发 insets，
  这样玻璃才能既铺到状态栏底下、又能把 dock 压进内容区（PRD D2 / §7.2）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- 状态栏区域的玻璃底。高度由 insets 在代码里给；经典外观下退回不透明页面底色 -->
    <View
        android:id="@+id/statusGlass"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/nav_background"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconDashboard"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="设备"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/labelDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="设备"
                android:textColor="@color/nav_inactive_icon"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabTransfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconTransfer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="相机照片"
                android:src="@drawable/ic_nav_album" />

            <TextView
                android:id="@+id/labelTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="相机照片"
                android:textColor="@color/nav_inactive_icon"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRemote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconRemote"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="拍摄"
                android:src="@drawable/ic_nav_camera" />

            <TextView
                android:id="@+id/labelRemote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="拍摄"
                android:textColor="@color/nav_inactive_icon"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="设置"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:id="@+id/labelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="设置"
                android:textColor="@color/nav_inactive_icon"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
