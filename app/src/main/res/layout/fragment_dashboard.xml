<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab1 设备首页：覆盖式顶栏 + 下拉刷新 + 设备卡/网格/详情折叠组。
  根是 FrameLayout：滚动区满高，topChrome（标题行 + 分割线 + 连接模式三选行）作为**不透明**
  覆盖层压在上面。顶栏玻璃已撤销（v2.3.1 §15.5h：背后是本页滚动区，采样慢一帧必然错位/闪烁，
  而白页上透出白 = 零收益），所以两种外观下顶栏完全一致。
  滚动区的 paddingTop 由 DashboardFragment 按 topChrome 实测高度给（首次布局前量不准），
  clipToPadding=false → 内容滚到顶栏底下被遮住，与普通 Toolbar 行为相同。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 下拉刷新连接状态 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_margin"
                android:paddingTop="@dimen/module_gap_large"
                android:paddingBottom="@dimen/module_gap_large">

                <!-- 模式专属内容：连接教程 + 设备列表 -->
                <LinearLayout
                    android:id="@+id/modePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- WiFi AP 模式 -->
                    <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/panelWifiAp"
        layout="@layout/view_panel_wifi_ap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

                    <!-- WiFi STA 模式 -->
                    <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/panelWifiSta"
        layout="@layout/view_panel_wifi_sta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

                    <!-- USB 有线模式 -->
                    <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/panelUsb"
        layout="@layout/view_panel_usb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 2026-10-18：v2.7 的「连接英雄图」（相机示意图 + 状态徽章）整块撤掉。
                     三个页签共用这一块，占 132dp + 卡片内边距，而它表达的"连没连上"
                     下方设备卡的状态行本来就写（未连接 / 已连接 / 正在连接…），
                     属于同一信息的第二遍呈现。删的是视觉，不是状态：
                     renderStatusLine 那条出口一字未动。 -->

                <!-- 扫描 / 连接 并列操作容器 -->
                <!-- 2026-10-17 按钮合行：模式专属的那颗按钮（AP 的「连接相机 Wi-Fi」、
                     STA 的「手动输入相机 IP」）从各自页签卡片里搬进本行，与「连接相机」
                     并排 —— 纵向各省下一颗按钮（46dp + 上间距）。同一时刻只可能出现
                     一颗专属按钮，显隐由 DashboardFragment.applyActionRowVisibility 按页签给。
                     两颗按钮的点击逻辑零改动（showApWifiDialog / showManualIpDialog）。
                     窄屏保护：12sp + 收紧内边距 + maxLines=1 + ellipsize，
                     定高 46dp 下换行会被裁切，所以宁可省略号也不让它折行。 -->
                <LinearLayout
                    android:id="@+id/actionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeScan"
                        style="@style/NlButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:maxLines="1"
                        android:text="@string/btn_mode_scan_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApWifiConnect"
                        style="@style/NlButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:ellipsize="end"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/space_8"
                        android:maxLines="1"
                        android:text="@string/btn_ap_wifi_connect_text"
                        android:textSize="@dimen/font_nav"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStaManualIp"
                        style="@style/NlButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:ellipsize="end"
                        android:minWidth="0dp"
                        android:paddingHorizontal="@dimen/space_8"
                        android:maxLines="1"
                        android:text="@string/btn_sta_manual_ip_text"
                        android:textSize="@dimen/font_nav"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeConnect"
                        style="@style/NlButton.Primary"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/space_8"
                        android:text="@string/btn_mode_connect_text" />
                </LinearLayout>

                <!-- 2026-10-18：STA 的「最近连接设备 / 已发现相机」两栏从 WiFi STA 面板里
                     搬到这里，落在操作行下方 —— 先给入口（手动输入 IP、连接相机），再列结果。
                     这两栏只服务 STA + PTP/IP 直连：FTP 推送架构下手机是接收端，
                     没有"可连的相机"；AP / USB 页签同样不显示。显隐见 applyActionRowVisibility。 -->
                <LinearLayout
                    android:id="@+id/staLists"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/NlText.GroupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/txt_最近连接设备" />

                    <LinearLayout
                        android:id="@+id/recentDeviceList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/NlText.GroupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/txt_已发现相机" />

                    <LinearLayout
                        android:id="@+id/staCandidateList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 设备核心卡片（页面视觉中心） -->
                <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/cardDevice"
        layout="@layout/view_card_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/module_gap" />

                <!-- 相机参数四宫格（2026-10-17 改版）
                     原先这里是四张快捷入口卡（遥控拍摄 / 查看相册 / WiFi 频段 / 传输设置）。
                     跳转能力与底部 dock 完全重复（拍摄 = tabRemote、相机照片 = tabTransfer、
                     设置 = tabSettings），频段又与「相机详情」折叠组里的 Wi-Fi 频行重复，
                     于是这四格改为承载相机参数：快门次数 / 镜头 / 电池电量 / 存储卡（含剩余可拍）。
                     设备卡与详情组里对应的行同步删除，一条信息只出现在一个地方。
                     几何：沿用 96dp 定高 + columnWeight=1 两列 + space_12 行距，窄屏（320dp）
                     下每格仍拿到约 (屏宽-页边距×2-6)/2 的宽度；三行文字全部 maxLines=1 +
                     ellipsize=end，定高容器内绝不允许换行裁切。 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/module_gap_large"
                    android:columnCount="2">

                    <LinearLayout
                        android:id="@+id/cardTileShutter"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="@dimen/space_12"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_12">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/txt_快门次数"
                                android:src="@drawable/ic_nav_camera"
                                android:importantForAccessibility="no"
                                app:tint="@color/text_tertiary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/txt_快门次数"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_foot" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTileShutter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tv_tile_placeholder_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTileShutterSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/font_foot"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardTileLens"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="@dimen/space_12"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_12">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/txt_镜头"
                                android:src="@drawable/ic_lens"
                                android:importantForAccessibility="no"
                                app:tint="@color/text_tertiary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/txt_镜头"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_foot" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTileLens"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/tv_tile_placeholder_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTileLensSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/font_foot"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardTileBattery"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_12">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/txt_电池电量"
                                android:src="@drawable/ic_battery"
                                android:importantForAccessibility="no"
                                app:tint="@color/text_tertiary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/txt_电池电量"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_foot" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTileBattery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tv_tile_placeholder_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_title"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardTileStorage"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_12"
                        android:paddingVertical="@dimen/space_12">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@string/txt_存储卡"
                                android:src="@drawable/ic_sd_card"
                                android:importantForAccessibility="no"
                                app:tint="@color/text_tertiary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/txt_存储卡"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_foot" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTileStorage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/tv_tile_placeholder_text"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_title"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbTileStorage"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="@color/divider"
                            android:progressTint="@color/text_primary"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvTileStorageSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/font_foot"
                            android:visibility="gone" />
                    </LinearLayout>
                </GridLayout>

                <!-- 相机详情折叠组 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/module_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowDetailHeader"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_20">

                        <TextView
                            style="@style/NlText.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/txt_相机详情" />

                        <ImageView
                            android:id="@+id/iconDetailChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="展开"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/space_20"
                        android:paddingBottom="@dimen/space_16"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:background="@color/divider" />

                        <!-- 快门次数已搬进上方参数四宫格（2026-10-17），本组不再重复一次 -->
                        <LinearLayout
                            android:id="@+id/rowFirmware"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/txt_固件版本"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvFirmware"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowBleSignal"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/txt_蓝牙信号"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvBleSignal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowWifiBand"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/txt_wi_fi频"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvWifiBand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/txt_重连次数"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvReconnectCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tv_reconnect_count_text"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 覆盖式顶栏：原先竖向排列的三件 chrome 整体搬到滚动区之上。
         底色与几何来自 NlTopChrome / NlTopBar / NlTopDivider（三页共用，一处改全局生效）-->
    <LinearLayout
        android:id="@+id/topChrome"
        style="@style/NlTopChrome">

        <!-- 顶部导航：标题 + 设置入口，底部 1px 分割线 -->
        <LinearLayout
            android:id="@+id/topBar"
            style="@style/NlTopBar">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/NlText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tv_title_text" />

            <ImageView
                android:id="@+id/btnSettingsIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <View
            android:id="@+id/topDivider"
            style="@style/NlTopDivider" />

    <!-- 顶部连接模式选择：药丸滑动 Tab -->
    <LinearLayout
        android:id="@+id/modeTabSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/modeTabContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:padding="3dp">

            <View
                android:id="@+id/modeTabIndicator"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_chip_selected" />

            <LinearLayout
                android:id="@+id/modeTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabWifiAp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/tab_wifi_ap_text"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/font_nav"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabWifiSta"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/tab_wifi_sta_text"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_nav" />

                <TextView
                    android:id="@+id/tabUsb"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/tab_usb_text"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_nav" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
