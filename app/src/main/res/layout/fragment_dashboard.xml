<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab1 设备首页：覆盖式顶栏 + 下拉刷新 + 设备卡/网格/详情折叠组。
  根是 FrameLayout：滚动区满高，topChrome（标题行 + 分割线 + 连接模式三选行）作为**不透明**
  覆盖层压在上面。顶栏玻璃已撤销（v2.3.1 §15.5h：背后是本页滚动区，采样慢一帧必然错位/闪烁，
  而白页上透出白 = 零收益），所以两种外观下顶栏完全一致。
  滚动区的 paddingTop 由 DashboardFragment 按 topChrome 实测高度给（首次布局前量不准），
  clipToPadding=false → 内容滚到顶栏底下被遮住，与普通 Toolbar 行为相同。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 下拉刷新连接状态 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/page_margin"
                android:paddingTop="@dimen/module_gap_large"
                android:paddingBottom="@dimen/module_gap_large">

                <!-- 模式专属内容：连接教程 + 设备列表 -->
                <LinearLayout
                    android:id="@+id/modePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- WiFi AP 模式 -->
                    <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/panelWifiAp"
        layout="@layout/view_panel_wifi_ap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

                    <!-- WiFi STA 模式 -->
                    <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/panelWifiSta"
        layout="@layout/view_panel_wifi_sta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

                    <!-- USB 有线模式 -->
                    <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/panelUsb"
        layout="@layout/view_panel_usb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- v2.7 连接英雄图：常驻相机视觉 + 状态徽章。
                     规划 §2.5「首屏零等待感」—— 无相机时页面也要有视觉重心，所以相机图与
                     徽章恒显；扫描/连接按钮仍在其下方的 actionContainer 里，不新增 CTA。
                     尺寸全为 dp 固定 + FrameLayout 居中：手机 / 平板 / 桌面窗口下
                     相机图始终居中、徽章始终贴舞台右上角，表现一致。
                     徽章**不贴角**：算过窄屏的账 —— 320dp 屏上台面宽仅 248dp，
                     相机图右缘 185dp、徽章左缘 168dp，角标会压住快门键与辅助灯。
                     改为「相机图居中、徽章居中置于图下方（间距 8dp）」，
                     横向约束消失，任何屏宽下都不遮挡机身任何细节。 -->
                <LinearLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/heroStage"
                        android:layout_width="match_parent"
                        android:layout_height="132dp"
                        android:background="@drawable/bg_camera_hero">

                        <ImageView
                            android:id="@+id/ivCameraHero"
                            android:layout_width="112dp"
                            android:layout_height="78dp"
                            android:layout_gravity="center_horizontal|top"
                            android:layout_marginTop="10dp"
                            android:contentDescription="相机"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_camera_hero" />

                        <LinearLayout
                            android:id="@+id/heroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="center_horizontal|bottom"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_hero_badge"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp">

                            <View
                                android:id="@+id/heroBadgeDot"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_status_dot" />

                            <TextView
                                android:id="@+id/tvHeroBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="未连接"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_nav" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- 扫描 / 连接 并列操作容器 -->
                <LinearLayout
                    android:id="@+id/actionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/group_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeScan"
                        style="@style/NlButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="扫描相机" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeConnect"
                        style="@style/NlButton.Primary"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="连接相机" />
                </LinearLayout>

                <!-- 设备核心卡片（页面视觉中心） -->
                <!-- 视T6：本块抽取为独立布局（内容零改动，回退=revert 本提交） -->
    <include
        android:id="@+id/cardDevice"
        layout="@layout/view_card_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/module_gap" />

                <!-- 快捷功能网格 2x2 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/module_gap_large"
                    android:columnCount="2">

                    <LinearLayout
                        android:id="@+id/cardQuickRemote"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="20dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="遥控拍摄"
                            android:src="@drawable/ic_nav_camera"
                            app:tint="@color/text_primary" />

                        <TextView
                            style="@style/NlText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="遥控拍摄" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardQuickAlbum"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="20dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="查看相册"
                            android:src="@drawable/ic_nav_album"
                            app:tint="@color/text_primary" />

                        <TextView
                            style="@style/NlText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="查看相册" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardWifiSpeed"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="20dp">

                        <ImageView
                            android:id="@+id/ivWifiBandCard"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="WiFi 频段"
                            android:src="@drawable/ic_wifi_sta"
                            app:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvWifiBandCard"
                            style="@style/NlText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="WiFi 频段" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardQuickSettings"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="20dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="传输设置"
                            android:src="@drawable/ic_nav_settings"
                            app:tint="@color/text_primary" />

                        <TextView
                            style="@style/NlText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="传输设置" />
                    </LinearLayout>
                </GridLayout>

                <!-- 相机详情折叠组 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/module_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowDetailHeader"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <TextView
                            style="@style/NlText.SectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="相机详情" />

                        <ImageView
                            android:id="@+id/iconDetailChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="展开"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:id="@+id/rowShutterCount"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="快门次数"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvShutterCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowFirmware"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="固件版本"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvFirmware"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowBleSignal"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="蓝牙信号"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvBleSignal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowWifiBand"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="WiFi 频段"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvWifiBand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="重连次数"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption" />

                            <TextView
                                android:id="@+id/tvReconnectCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 次"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 覆盖式顶栏：原先竖向排列的三件 chrome 整体搬到滚动区之上。
         底色与几何来自 NlTopChrome / NlTopBar / NlTopDivider（三页共用，一处改全局生效）-->
    <LinearLayout
        android:id="@+id/topChrome"
        style="@style/NlTopChrome">

        <!-- 顶部导航：标题 + 设置入口，底部 1px 分割线 -->
        <LinearLayout
            android:id="@+id/topBar"
            style="@style/NlTopBar">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/NlText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="我的设备" />

            <ImageView
                android:id="@+id/btnSettingsIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:padding="12dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <View
            android:id="@+id/topDivider"
            style="@style/NlTopDivider" />

    <!-- 顶部连接模式选择：药丸滑动 Tab -->
    <LinearLayout
        android:id="@+id/modeTabSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/modeTabContainer"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:padding="3dp">

            <View
                android:id="@+id/modeTabIndicator"
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_chip_selected" />

            <LinearLayout
                android:id="@+id/modeTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabWifiAp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="WiFi AP 连接"
                    android:textColor="@color/on_primary"
                    android:textSize="@dimen/font_nav"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabWifiSta"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="WiFi STA 连接"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_nav" />

                <TextView
                    android:id="@+id/tabUsb"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="USB 有线连接"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_nav" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
