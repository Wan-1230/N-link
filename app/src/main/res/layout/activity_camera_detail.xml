<?xml version="1.0" encoding="utf-8"?>
<!-- 相机详情页：只读展示 + 低风险操作（刷新 / 固件比对 / 位置同步 / 复制诊断）。
     不提供固件刷写：N-Link 不接管相机固件升级流程。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:text="相机详情"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnRefresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="刷新相机信息"
                android:padding="11dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- 相机身份 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nikon"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="未连接"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_caption" />
        </LinearLayout>

        <!-- 相机信息 -->
        <TextView
            style="@style/NlText.GroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:text="相机信息" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap_small"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="型号"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="固件版本"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvFirmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="序列号"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="镜头"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvLens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="220dp"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="快门次数"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvShutter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="电池"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="存储卡"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- 连接 -->
        <TextView
            style="@style/NlText.GroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:text="连接" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap_small"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="连接方式"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvTransport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wi-Fi 频段"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="蓝牙信号"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvBle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本次连接时长"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="重连次数"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvReconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 次"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- 位置同步 -->
        <TextView
            style="@style/NlText.GroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:text="位置同步" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap_small"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:id="@+id/tvLocationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncLocation"
                style="@style/NlButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/space_12"
                android:text="立即把当前位置写入相机" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="2dp"
                android:text="这是「写入相机」，只影响相机此后拍摄的照片；与设置里的「分享副本保留 GPS」互不影响。"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/font_foot" />
        </LinearLayout>

        <!-- 能力 -->
        <TextView
            style="@style/NlText.GroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:text="本机支持的能力" />

        <GridLayout
            android:id="@+id/capabilityGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap_small"
            android:background="@drawable/bg_card"
            android:columnCount="2"
            android:padding="@dimen/space_12" />

        <TextView
            android:id="@+id/tvCapabilityNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_foot" />

        <!-- 固件 -->
        <TextView
            style="@style/NlText.GroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:text="固件更新" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap_small"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                android:id="@+id/tvFirmwareNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckFirmware"
                style="@style/NlButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/space_12"
                android:text="检查固件更新" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfficialFirmware"
                style="@style/NlButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/space_8"
                android:text="打开尼康下载中心" />
        </LinearLayout>

        <!-- 诊断 -->
        <TextView
            style="@style/NlText.GroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:text="诊断" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/group_gap_small"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyInfo"
                style="@style/NlButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="复制相机信息" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="2dp"
                android:text="仅复制型号、固件、序列号后四位与连接指标，不包含 IP / MAC 或照片内容。"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/font_foot" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/module_gap_large"
            android:lineSpacingExtra="2dp"
            android:text="N-Link 不下载、不刷写相机固件。固件升级请在相机上按尼康官方说明完成。"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/font_foot" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
