<?xml version="1.0" encoding="utf-8"?>
<!-- 视T6 自 fragment_dashboard 抽取：原块内容零改动 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="gone">


                        <!-- v2.6.3：STA 架构分段切换（药丸）。
                             原型与相册页底部 albumTabPill 完全一致：FrameLayout 底 + 指示器 View
                             + 等宽 TextView 行，玻璃态下整枚药丸本身就是悬浮玻璃面
                             （GlassTokens.tabPill），经典外观下退回 bg_chip 实心胶囊。
                             选中态 = 黑底白字加粗（bg_chip_selected + on_primary），
                             与相册页分页的视觉语言一致。 -->
                        <FrameLayout
                            android:id="@+id/staArchPill"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginBottom="@dimen/space_12"
                            android:background="@drawable/bg_chip"
                            android:padding="3dp">

                            <View
                                android:id="@+id/staArchIndicator"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_chip_selected" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tabStaArchPtp"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="@string/tab_sta_arch_ptp_text"
                                    android:textColor="@color/on_primary"
                                    android:textSize="@dimen/font_caption"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tabStaArchFtp"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="@string/tab_sta_arch_ftp_text"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/font_caption" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- 架构 A：PTP/IP 直连（原实现，逻辑零改动，仅被包进本容器） -->
                        <LinearLayout
                            android:id="@+id/layoutStaPtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:padding="@dimen/space_16">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:contentDescription="WiFi STA"
                                    android:src="@drawable/ic_wifi_sta"
                                    app:tint="@color/text_primary" />

                                <TextView
                                    style="@style/NlText.SectionTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/txt_wi_fi_s" />
                            </LinearLayout>

                            <!-- 连接教程：默认收起，仅留一个展开按钮（点击后展开） -->
                            <LinearLayout
                                android:id="@+id/staGuideHeader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="6dp">

                                <TextView
                                    style="@style/NlText.Subtitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/txt_connection_guide" />

                                <ImageView
                                    android:id="@+id/staGuideChevron"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:contentDescription="展开教程"
                                    android:src="@drawable/ic_chevron_down"
                                    app:tint="@color/text_tertiary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvStaGuide"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="3dp"
                                android:text="首次使用先注册一次（之后不再需要）：\n  相机菜单 →「Wi-Fi连接（STA mode）」创建配置文件（旧固件在「连接至 PC」→ 网络设定里）。\n  向导连上网后会停在「正在等待连接」的画面 —— 注册必须在这一步做：\n  让手机与相机处于同一网络，回到本页点「STA 主机注册」，相机屏幕按 OK（约 10 秒）。\n  ⚠ 普通的「连接至智能设备」热点也能连上相机，但它不接受注册，点了报 0x201F。\n\n日常连接：\n  ① 手机与相机连接同一个路由器\n  ② 相机菜单进入「WiFi 连接（STA mode）」，选择该路由器，停在等待画面\n  ③ 点「连接相机」——自动搜索并接续，无需扫描\n搜不到相机时：确认相机停在等待连接画面、手机没开 VPN、路由器没开 AP 隔离（都会挡掉设备发现）；仍搜不到可点空态里的「手动输入相机 IP」"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption"
                                android:visibility="gone" />

                            <!-- v1.0.2 拆分：两种 STA 子模式（发现与路由策略不同） -->
                            <LinearLayout
                                android:id="@+id/staModeRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_12"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/chipStaSameWifi"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_chip_selected"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/space_8"
                                    android:text="@string/chip_sta_same_wifi_text"
                                    android:textColor="@color/on_primary"
                                    android:textSize="@dimen/font_caption" />

                                <TextView
                                    android:id="@+id/chipStaHotspot"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_chip"
                                    android:gravity="center"
                                    android:paddingVertical="@dimen/space_8"
                                    android:text="@string/chip_sta_hotspot_text"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/font_caption" />
                            </LinearLayout>

                            <!-- STA 主机注册：常驻入口。相机未记住本机时用强调色显示 -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStaHostRegister"
                                style="@style/NlButton.Outline"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="14dp"
                                android:text="@string/btn_sta_host_register_text" />

                            <TextView
                                android:id="@+id/tvStaHostRegStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_8"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_caption"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            style="@style/NlText.GroupTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="@dimen/space_8"
                            android:text="@string/txt_最近连接设备" />

                        <LinearLayout
                            android:id="@+id/recentDeviceList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            style="@style/NlText.GroupTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="@dimen/space_8"
                            android:text="@string/txt_已发现相机" />

                        <LinearLayout
                            android:id="@+id/staCandidateList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                        </LinearLayout><!-- /layoutStaPtp -->

                        <!-- 架构 B：FTP 推送收图（PRD §4.5 备选架构）。
                             相机主动把照片推给本机 FTP 服务器 —— **不需要主机注册**，
                             因此绕开了 STA 门控。本容器与 layoutStaPtp 完全互斥，
                             状态各自独立（见 DashboardViewModel.ftpState）。 -->
                        <LinearLayout
                            android:id="@+id/layoutStaFtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:padding="@dimen/space_16">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:contentDescription="FTP 推送"
                                        android:src="@drawable/ic_wifi_sta"
                                        app:tint="@color/text_primary" />

                                    <TextView
                                        style="@style/NlText.SectionTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:text="@string/txt_f_t_p推送" />
                                </LinearLayout>

                                <!-- 连接教程：默认收起，仅留一个展开按钮（点击后展开） -->
                                <LinearLayout
                                    android:id="@+id/ftpGuideHeader"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:background="?attr/selectableItemBackground"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingVertical="6dp">

                                    <TextView
                                        style="@style/NlText.Subtitle"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/txt_connection_guide" />

                                    <ImageView
                                        android:id="@+id/ftpGuideChevron"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="展开教程"
                                        android:src="@drawable/ic_chevron_down"
                                        app:tint="@color/text_tertiary" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvFtpGuide"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:lineSpacingExtra="3dp"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/font_caption"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/module_gap"
                                android:background="@drawable/bg_card"
                                android:orientation="vertical"
                                android:padding="@dimen/space_16">

                                <TextView
                                    style="@style/NlText.Subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/txt_本机_f_t_p" />

                                <TextView
                                    android:id="@+id/tvFtpState"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/font_caption" />

                                <TextView
                                    android:id="@+id/tvFtpEndpoint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/font_body"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/txt_用户名"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="@dimen/font_caption" />

                                    <TextView
                                        android:id="@+id/tvFtpUser"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/text_primary"
                                        android:textSize="@dimen/font_caption" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/txt_密码"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="@dimen/font_caption" />

                                    <TextView
                                        android:id="@+id/tvFtpPass"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/text_primary"
                                        android:textSize="@dimen/font_caption" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnFtpToggle"
                                    style="@style/NlButton.Primary"
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:layout_marginTop="14dp"
                                    android:text="@string/btn_ftp_toggle_text" />

                                <TextView
                                    android:id="@+id/tvFtpHint"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_8"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/font_caption"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/tvFtpStats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/font_caption"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:id="@+id/ftpLogList"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout><!-- /layoutStaFtp -->
                    
</LinearLayout>
