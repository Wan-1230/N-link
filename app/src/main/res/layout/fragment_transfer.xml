<?xml version="1.0" encoding="utf-8"?>
<!-- Tab2 相机照片：顶部导航 + 分类标签 + 相机/本地双标签 + 影像网格 + 多选悬浮操作栏 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 顶部导航：标题 + 筛选 + 多选。几何来自 NlTopBar（三页共用）；
         宽度 0dp + 约束是本页 ConstraintLayout 的需要，覆盖 style 里的 match_parent -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/NlTopBar"
        android:layout_width="0dp"
        android:background="@color/background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 标题自动缩放（v2.6.3 修复「标题栏显示不全」）：
             本页顶栏是三页里控件最多的 —— 跳过已下载(48) + 刷新(48) + 排序(minWidth) +
             多选，尾部落到 242dp，加 page_margin 48dp 后 360dp 屏上标题只剩 ~70dp，
             而 24sp 的「相机照片」要 ~96dp → 只能显示两个字。
             autoSize 让标题在 24sp→16sp 之间缩，宽了就完整显示、实在放不下才退回省略号。
             设备页/设置页控件少、空间充裕，保持固定 24sp 不动（本页单独改，不进共享 style）。 -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/NlText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp"
            android:text="@string/tv_title_text_3" />

        <!-- 模块 4.2：「跳过已下载」开关。XML 注释写的"仅已标记栏可见"已过时 ——
             v1.3.0 需求 2 把它扩到了相机照片源（见 renderSkipDownloadedChip），
             正是这次标题被挤没的直接原因。置于刷新键左侧 -->
        <ImageView
            android:id="@+id/btnSkipDownloaded"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="跳过已下载"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_skip_downloaded"
            android:visibility="gone"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/btnRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="刷新"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_8"
            android:minWidth="64dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="选择相册排序方式（拍摄时间 / 文件类型，升序或降序）"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/btn_sort_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />

        <TextView
            android:id="@+id/btnMultiSelect"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/btn_multi_select_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        style="@style/NlTopDivider"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- 分类标签栏：横向滚动胶囊 -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingVertical="10dp"
        android:paddingHorizontal="@dimen/page_margin"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topDivider">

        <LinearLayout
            android:id="@+id/chipRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- O2：剩余下载进度（已下载 M/N · 剩余 K 张）——仅相机照片源可见。
         放在 chip 行下方，网格从它下面开始；注意：不能挂在 tvMessage 上——
         它在 layoutEmpty 空态内，列表非空时整个空态都是 GONE。 -->
    <TextView
        android:id="@+id/tvDownloadStats"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center_vertical|start"
        android:layout_marginHorizontal="@dimen/page_margin"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_caption"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipScroll" />

    <!-- 下拉刷新容器 + 影像网格：3 列等宽方形 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_4"
        app:layout_constraintBottom_toTopOf="@id/albumTabRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDownloadStats">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridPhotos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="2dp"
                android:paddingBottom="@dimen/space_12"
                android:scrollbars="none" />

            <!-- 空状态 / 加载提示（视S2：空态 = 图标容器 + 引导语，替代纯文字） -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <!-- v2.7：emoji 占位换成与首页同一张自绘矢量相机（drawable/ic_camera_hero）。
                     容器沿用 72dp 圆角方块（规划 §2.2「图标容器」），padding 6dp 给机身留白，
                     与 DashboardFragment 空态的相机图保持同一观感。
                     注意：本空态的 tvMessage 同时兼作下载进度文案（见 TransferFragment），
                     所以这里只换图标，不动文案结构。 -->
                <ImageView
                    android:id="@+id/ivEmptyIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_skeleton"
                    android:contentDescription="相机"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camera_hero"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminateTint="@color/text_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="3"
                    android:paddingHorizontal="40dp"
                    android:text="@string/tv_message_text"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <!-- 视S2 相册骨架屏：加载期替代转圈，2 行 × 3 列灰块 + alpha 脉冲（代码驱动） -->
            <LinearLayout
                android:id="@+id/skeletonGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="2dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_skeleton" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        android:layout_margin="1dp"
                        android:background="@drawable/bg_skeleton" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 底部标签栏：相机照片 / 本地照片 -->
        <LinearLayout
            android:id="@+id/albumTabRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- 模块 4.5：滑动指示器（选中胶囊随 Tab 切换平移动画 180ms）。
                 玻璃态下这枚 40dp 药丸本身就是悬浮玻璃面（bg_chip 实心底让位给材质），
                 经典外观下它还是那颗 #F0F0F0 胶囊。 -->
            <FrameLayout
                android:id="@+id/albumTabPill"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:padding="3dp">

                <!-- 初始宽度 0dp：宽度由 renderAlbumTabs 按行宽/Tab 数运行时设置。
                     旧值 match_parent 会在 Fragment 处于 hidden（GONE 不布局）时
                     保持全宽黑胶囊，未选中 Tab 的黑字叠黑底不可见 →「只见 1 个 Tab」 -->
                <View
                    android:id="@+id/tabIndicator"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chip_selected" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabCameraPhotos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/tab_camera_photos_text"
                        android:textColor="@color/on_primary"
                        android:textSize="@dimen/font_caption"
                        android:textStyle="bold" />

                    <!-- F1「已标记」独立分区：聚合跨卡跨日的标记照片，一键批量收片 -->
                    <TextView
                        android:id="@+id/tabMarkedPhotos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/tab_marked_photos_text"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_caption" />

                    <TextView
                        android:id="@+id/tabLocalPhotos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/tab_local_photos_text"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

    <!-- 下载队列入口：队列里有任务时浮在多选操作栏上方，「下载中 n/m」，点开是队列面板。
         挂在 bottomBar 顶上：操作栏 GONE 时 ConstraintLayout 把它收成标签行顶部的一个点，
         入口自然落到标签行上方 12dp；操作栏出现时入口跟着上移，两者不重叠。 -->
    <TextView
        android:id="@+id/btnQueue"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="@dimen/space_12"
        android:background="@drawable/bg_chip_selected"
        android:contentDescription="下载队列"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingHorizontal="@dimen/space_16"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/font_caption"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 底部悬浮操作栏（多选模式）：下载 / 删除 / 分享 / 全选 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/space_20"
        android:layout_marginBottom="@dimen/space_12"
        android:background="@drawable/bg_floating_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/albumTabRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:text="@string/tv_selected_count_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption"
            android:textStyle="bold" />

        <!-- F1：标记/取消标记（切换语义：选中集全部已标 → 取消，否则 → 打标） -->
        <TextView
            android:id="@+id/btnMark"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/btn_mark_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/btn_select_all_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />

        <TextView
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/btn_share_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_12"
            android:text="@string/btn_delete_text"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/font_caption" />

        <TextView
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chip_selected"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_16"
            android:text="@string/btn_download_text"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/font_caption"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
